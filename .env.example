# HOST is your LAN IP; VITE_SUPABASE_URL is https://HOST/supabase (Caddy proxies to Supabase)
HOST=192.168.7.40
# Get local keys from `npx supabase status` (Publishable key) after `npx supabase start`
VITE_SUPABASE_URL=https://192.168.7.40/supabase
VITE_SUPABASE_ANON_KEY=
# E2E only (never in frontend): SUPABASE_SECRET_KEY=<Secret key from supabase status>
